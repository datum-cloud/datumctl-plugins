{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin",
  "description": "A datumctl plugin manifest (apiVersion: datumctl.datum.net/v1alpha1, kind: Plugin)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "datumctl.datum.net/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Plugin"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Short plugin name, e.g. 'compute'. Must be lowercase alphanumeric with hyphens."
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["shortDescription", "version", "platforms"],
      "properties": {
        "shortDescription": {
          "type": "string",
          "maxLength": 120,
          "description": "One-line summary shown in datumctl plugin search."
        },
        "description": {
          "type": "string",
          "description": "Optional longer help text."
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]",
          "description": "Semantic version string, e.g. v1.2.0"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uri", "sha256"],
            "properties": {
              "selector": {
                "type": "object",
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "properties": {
                      "os": {
                        "type": "string",
                        "enum": ["linux", "darwin", "windows"]
                      },
                      "arch": {
                        "type": "string",
                        "enum": ["amd64", "arm64", "386"]
                      }
                    }
                  }
                }
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "Lowercase hex SHA256 of the archive at uri."
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from"],
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
