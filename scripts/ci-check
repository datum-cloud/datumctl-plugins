#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

venv=$(mktemp -d)
trap 'rm -rf "$venv"' EXIT
python3 -m venv "$venv"
"$venv/bin/pip" install --quiet 'jsonschema==4.26.0' 'PyYAML==6.0.3'

"$venv/bin/python" -c '
import glob, json, sys
import yaml
from jsonschema import Draft7Validator

with open("schema/plugin-v1alpha1.json") as fh:
    validator = Draft7Validator(json.load(fh))

paths = sorted(glob.glob("plugins/*.yaml"))
if not paths:
    sys.exit("ci-check: found zero plugin manifests under plugins/")

failed = False
for path in paths:
    with open(path) as fh:
        manifest = yaml.safe_load(fh)
    errors = sorted(validator.iter_errors(manifest), key=lambda e: list(e.path))
    for e in errors:
        loc = "/".join(str(p) for p in e.path) or "(root)"
        print(f"{path}: {loc}: {e.message}", file=sys.stderr)
    failed = failed or bool(errors)
    print(path + (": FAIL" if errors else ": ok"))

with open("index.yaml") as fh:
    yaml.safe_load(fh)
sys.exit(1 if failed else 0)
'

"$venv/bin/python" -c '
import sys
with open(sys.argv[1]) as fh:
    compile(fh.read(), sys.argv[1], "exec")
' scripts/scan-upstream-releases.py
